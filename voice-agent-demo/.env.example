# mock = offline architecture demo (no cloud keys)
# cloud = Qwen ASR + graded LLM + MiniMax TTS
AGENT_MODE=mock
# faq | repair_order
BUSINESS_MODE=repair_order
REPAIR_ORDER_USE_LLM_EXTRACTOR=true
REPAIR_ORDER_EXTRACT_TIMEOUT_S=3.0
ENABLE_WAIT_FILLER=true
PROMPT_AUDIO_DIR=audio/yue
FILLER_MIN_USER_CHARS=12

# ---- Qwen3-ASR-Flash-Realtime (DashScope) ----
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
# Empty enables automatic Cantonese / Mandarin / English detection.
DASHSCOPE_ASR_LANGUAGE=
# China Beijing default; Singapore: wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_SILENCE_MS=400
DASHSCOPE_ASR_FINAL_TIMEOUT_MS=2500

# ---- MiniMax Speech 2.8 Turbo ----
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=Chinese (Mandarin)_Warm_Girl
MINIMAX_LANGUAGE_BOOST=Chinese,Yue
MINIMAX_WS_URL=wss://api.minimax.io/ws/v1/t2a_v2
# Mainland alternative often: wss://api.minimaxi.com/ws/v1/t2a_v2
MINIMAX_SAMPLE_RATE=16000
MINIMAX_AUDIO_FORMAT=pcm

# ---- L1 fast LLM (primary realtime path) ----
FAST_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAST_LLM_API_KEY=
FAST_LLM_MODEL=qwen-plus
FAST_LLM_MAX_TOKENS=60
FAST_LLM_TEMPERATURE=0.4
FAST_LLM_TIMEOUT_S=3.0

# ---- L2 complex LLM (Bonsai) ----
BONSAI_BASE_URL=http://172.17.7.90:8080/v1
BONSAI_API_KEY=
BONSAI_MODEL=bonsai-2-27b
BONSAI_MAX_TOKENS=80
BONSAI_TEMPERATURE=0.5
BONSAI_DISABLE_THINKING=true

LLM_SYSTEM_PROMPT=你是电话语音助手。用一两句短口语回答，总字数不超过40字。用户说粤语就用粤语，说普通话就用普通话，说英文就用英文。第一句直接给答案，不要解释、不要列表。不要说你是AI。

# ---- Server ----
HOST=127.0.0.1
PORT=7862
SAMPLE_RATE=16000
FRAME_MS=20
VAD_SILENCE_MS=650
VAD_ENERGY_THRESHOLD=280
VAD_WEBRTC_MODE=2
VAD_NOISE_MULTIPLIER=2.5
VAD_MAX_SPEECH_MS=12000
VAD_WINDOW_MS=1200
VAD_WINDOW_MIN_VOICED_RATIO=0.35
BARGE_IN_MIN_MS=180
BARGE_IN_THINKING_MIN_MS=500
BARGE_IN_ENERGY_RATIO=1.2
PLAYBACK_DONE_GRACE_MS=450
